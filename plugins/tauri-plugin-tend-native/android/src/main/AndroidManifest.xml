<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Health Connect's library asks for Android 8; it's only used on Android 9+. -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Self-update: hand a newer APK from the project's releases to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Steps and workouts from Health Connect, read while Tend is open. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <!-- Today's events from the phone's calendars (Google Calendar included), read-only. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application>
        <!-- A timed reminder is due. -->
        <receiver
            android:name="com.tend.native.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- The gentle periodic "still waiting" chime. -->
        <receiver
            android:name="com.tend.native.ChimeReceiver"
            android:exported="false" />

        <!-- The daily weather check-in. -->
        <receiver
            android:name="com.tend.native.MoodReceiver"
            android:exported="false" />

        <!-- Notification buttons: Done / 1 h / Tomorrow / Snooze, ✓ step, Add…, Quiet today. -->
        <receiver
            android:name="com.tend.native.ReminderActionReceiver"
            android:exported="false" />

        <!-- The "still to do" notification was swiped away: put it back. -->
        <receiver
            android:name="com.tend.native.PersistentDismissReceiver"
            android:exported="false" />

        <!-- Restore alarms / notification / unlock service after boot and app updates. -->
        <receiver
            android:name="com.tend.native.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Listens for ACTION_USER_PRESENT (only deliverable to runtime-registered receivers). -->
        <service
            android:name="com.tend.native.UnlockNudgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the user's own still-to-do reminder list right after they unlock the device, at their request (ADHD accessibility aid). The service only listens for the screen-unlock broadcast; it does no background work." />
        </service>

        <!-- Quick add without opening the app: share sheet (text), Quick Settings tile, shortcut, widget "+". -->
        <activity
            android:name="com.tend.native.QuickAddActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Add to Tend"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.tend.native.action.QUICK_ADD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Quick Settings tile: shows what's next, tap to add something. -->
        <service
            android:name="com.tend.native.TendTileService"
            android:exported="true"
            android:icon="@drawable/ic_tend_leaf"
            android:label="Tend"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Home-screen widget with today's list. -->
        <receiver
            android:name="com.tend.native.TendWidgetProvider"
            android:exported="true"
            android:label="Tend · today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tend_widget_info" />
        </receiver>

        <!-- A widget row was tapped. -->
        <receiver
            android:name="com.tend.native.WidgetTapReceiver"
            android:exported="false" />

        <!-- Why Tend reads steps and workouts. Health Connect requires it before it will ask. -->
        <activity
            android:name="com.tend.native.HealthPrivacyActivity"
            android:exported="true"
            android:label="Tend and your activity"
            android:theme="@android:style/Theme.Material.Light">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- The same page, as Android 14+ links to it from Health Connect's permission screens. -->
        <activity-alias
            android:name="com.tend.native.ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="com.tend.native.HealthPrivacyActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Shares the downloaded update with the system installer. -->
        <provider
            android:name="com.tend.native.TendUpdateFileProvider"
            android:authorities="${applicationId}.tendupdates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/tend_update_paths" />
        </provider>
    </application>
</manifest>
