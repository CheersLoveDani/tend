<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget. Rows are filled in by TendWidget.kt; unused ones are hidden. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tend_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tend_widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tend_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Tend"
            android:textColor="@color/tend_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tend_widget_add"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:contentDescription="Quick add"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/tend_accent"
            android:textSize="26sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tend_widget_row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingEnd="8dp"
        android:textColor="@color/tend_widget_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tend_widget_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingEnd="8dp"
        android:textColor="@color/tend_widget_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tend_widget_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingEnd="8dp"
        android:textColor="@color/tend_widget_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tend_widget_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingEnd="8dp"
        android:textColor="@color/tend_widget_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tend_widget_row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingEnd="8dp"
        android:textColor="@color/tend_widget_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tend_widget_row5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingEnd="8dp"
        android:textColor="@color/tend_widget_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tend_widget_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textColor="@color/tend_widget_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tend_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="Nothing waiting. Nice."
        android:textColor="@color/tend_widget_muted"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
